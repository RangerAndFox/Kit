# ─── Meeting transcripts ─────────────────────────────────────
# Direct Plaud sync (preferred). Authorize once with Plaud's official CLI,
# bootstrap the resulting refresh token in the server secret store, set an
# explicit historical frontier, then enable. Keep false until all three values
# are configured. At cutover, disable DRIVE_TRANSCRIPTS_ENABLED to prevent the
# old Zap/Drive path from importing the same new recordings.
PLAUD_INGEST_ENABLED=false
PLAUD_REFRESH_TOKEN=
# ISO-8601 timestamp for the first recording Kit should import. Required and
# fail-closed so existing Drive history is never duplicated accidentally.
PLAUD_INGEST_FROM=

# Temporary rollback path: Zapier drops Plaud transcripts into this Drive
# folder and Kit ingests them every 15 minutes.
DRIVE_TRANSCRIPTS_ENABLED=false
# The watched Drive folder id the zap writes transcripts into.
DRIVE_TRANSCRIPTS_FOLDER_ID=
# Service-account JSON (share the Drive folder with this account's email).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Default workspace id transcripts (and other features) attribute to.
KIT_DEFAULT_WORKSPACE_ID=

# ─── Google Calendar — pre-meeting briefings ─────────────────
# Master switch for the briefing cron. Leave 'false' until creds + calendars
# are set up and you've verified a test event flows through.
GOOGLE_CALENDAR_INGEST_ENABLED=false
# Reuses GOOGLE_SERVICE_ACCOUNT_JSON above (raw or base64-encoded).
# Comma-separated calendar IDs the service account has been shared into.
GOOGLE_CALENDAR_IDS=
# How far in advance to send briefings (minutes; default 30).
BRIEFING_LEAD_TIME_MINUTES=30
# Classifier confidence below which an event is skipped (0..1; default 0.5).
BRIEFING_MATCH_THRESHOLD=0.5
# Also post briefings to the project channel? PRIVACY: off by default —
# the channel exposes the prep to everyone in it, not just people on the call.
BRIEFING_POST_CHANNEL=false

# ─── Freelancer NDA / paperwork ───────────────────────────────
# Master switch. Leave 'false' until the items below are configured and the
# NDA template + Gmail delegation are verified.
FREELANCER_PAPERWORK_ENABLED=false
# The Workspace mailbox the NDA is sent *as* (Gmail impersonates this user).
# Requires domain-wide delegation: authorize the GOOGLE_SERVICE_ACCOUNT_JSON
# service account's client id for these scopes in Google Workspace Admin:
#   https://www.googleapis.com/auth/gmail.send  (send the NDA email)
#   https://www.googleapis.com/auth/drive       (convert the Company NDA .docx → PDF)
# The drive scope is only needed for the Company NDA (docx→PDF). The Individual
# NDA is a static PDF and needs only gmail.send.
ONBOARDING_FROM_EMAIL=
# Comma-separated cc list for the NDA email (studio copy). Default: Jared.
ONBOARDING_NDA_CC=jared@rangerandfox.tv
# (Reuses GOOGLE_SERVICE_ACCOUNT_JSON above — no separate credential needed.)

# ─── Delivery pipeline ────────────────────────────────────────
# Slack channel where Dropbox-detected files get posted for "pick a profile".
# Leave blank to disable the auto-scan notification (still works manually
# via `/kit deliver <path>`).
DELIVERY_NOTIFY_CHANNEL_ID=
# Comma-separated file extensions the Dropbox→Frame.io watcher should NOT
# mirror (e.g. audio sidecars dropped next to the video). Defaults to aac,m4v.
DELIVERY_DENY_EXTENSIONS=aac,m4v

# ─── Studio knowledge (RAG embeddings) ───────────────────────
# OpenAI API key for text-embedding-3-small. Required for the studio_knowledge
# agent to function. The same key is used by the project-summary embedder and
# (future) the notes capture path.
OPENAI_API_KEY=

# ─── Studio knowledge auto-summarization ─────────────────────
# Nightly cron regenerates per-project narrative summaries via Claude Haiku.
# Leave 'false' until you've verified the P1 backfill produced clean
# project_summary docs and don't want them auto-overwritten.
STUDIO_KNOWLEDGE_AUTO_SUMMARIZE_ENABLED=false

# ─── Slack (required on Vercel too — briefings post from Inngest) ──
SLACK_BOT_TOKEN=
# NOTE: no SLACK_SIGNING_SECRET. Slack reaches Kit only over Socket Mode on
# Railway (SLACK_APP_TOKEN, see bolt/.env), where Bolt owns verification —
# there is no Slack HTTP route on Vercel to sign-check.

# ─── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_APP_URL=
KIT_AUTH_REDIRECT_URL=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Optional Slack-bot override. Defaults to Kit's verified production Vercel alias.
KIT_DASHBOARD_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic (classifier, briefing prep notes, bizdev bios) ─
ANTHROPIC_API_KEY=

# ─── Inngest (cron scheduling — REQUIRED in production) ───────
# Without these, /api/inngest can't authenticate to Inngest Cloud and every
# cron (briefings, delivery scans, Plaud, brain) silently never fires.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ─── Dropbox + Frame.io (delivery crons run on Vercel) ────────
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
FRAMEIO_ADOBE_CLIENT_ID=
FRAMEIO_ADOBE_CLIENT_SECRET=
FRAMEIO_ADOBE_REFRESH_TOKEN=
FRAMEIO_ACCOUNT_ID=
FRAMEIO_WORKSPACE_ID=

# Health monitor — Slack channel for up/down alerts (watchdog cron every 10m)
KIT_HEALTH_CHANNEL_ID=

# Daily health digest — Slack user id who receives the 9am ET DM from Kit's bot
# (health-daily-digest cron). Defaults to the studio owner if unset; set to
# redirect or to a different recipient. Leave the channel var above for alerts.
KIT_HEALTH_DIGEST_USER_ID=

# ─── Project Control Source-of-Truth Sync ────────────────────
# Binds each new project to normalized workbook records and three read-only
# Slack canvases (Overview, Reference, Schedule), then one-way syncs
# Sheet→Canvas. Reuses GOOGLE_SERVICE_ACCOUNT_JSON — the service account
# must be granted EDITOR on the workbook and the Sheets API enabled.
#
# Creation-side binding remains DORMANT until PROJECT_CONTROL_CREATION_ENABLED
# is true. The recurring sync additionally requires
# PROJECT_CONTROL_SYNC_ENABLED=true.
# RF Production System — Native Google Sheets (Projects tab + normalized Links).
MASTER_PROJECT_LIST_SPREADSHEET_ID=1qF690PLEK-NrzNUywwkEY-SAzt3pgRc8dG8UzAXeGyo
MASTER_PROJECT_LIST_SHEET_ID=904721650
MASTER_PROJECT_LIST_HEADER_ROW=4
MASTER_PROJECT_LIST_LAYOUT=rf-production-v1
MASTER_PROJECT_LIST_LINKS_SHEET_ID=1721636671
MASTER_PROJECT_LIST_LINKS_HEADER_ROW=4
MASTER_PROJECT_LIST_SPECS_SHEET_ID=1377810846
MASTER_PROJECT_LIST_WORKBACK_SHEET_ID=1186252714
MASTER_PROJECT_LIST_ASSIGNMENTS_SHEET_ID=958596238
MASTER_PROJECT_LIST_DELIVERABLES_SHEET_ID=454974547
MASTER_PROJECT_LIST_STATUS_LOG_SHEET_ID=328162234
SLACK_PROJECT_CANVAS_TEMPLATE_IDS=F0BT5QT3C4E,F0BSSC7NZKR,F0BT3LH43U5
# Pin the Overview template explicitly. If omitted, Kit uses the first approved
# ID above; setting it explicitly keeps the three-template mapping obvious.
SLACK_PROJECT_CONTROL_TEMPLATE_FILE_ID=F0BT5QT3C4E
# Independent creation-side gate. When false, new-project provisioning behaves
# exactly as before this mission (no Sheet row, no binding, no managed Canvas,
# no exclusion from generic cloning). Separate from the sync gate below.
PROJECT_CONTROL_CREATION_ENABLED=false
# Gate for the recurring Vercel/Inngest Sheet→Canvas sync (every 10m).
PROJECT_CONTROL_SYNC_ENABLED=false
# Railway uses the same signed endpoint as Apps Script to request an immediate
# refresh after Kit writes Latest Share or advances a workback. The cron remains
# the fallback if this request cannot be delivered.
PROJECT_CONTROL_WEBHOOK_URL=
PROJECT_CONTROL_WEBHOOK_SECRET=
# Optional ops channel for sync error/orphan/recovery alerts (falls back to
# KIT_HEALTH_CHANNEL_ID).
KIT_PROJECT_CONTROL_ALERT_CHANNEL_ID=

# ─── Pilots (Visual Development Pilot) ───────────────────────────────────────
# Reversible gate for the bounded, evidence-driven Pilots capability
# (`/kit pilot …`, migration 058). When false/unset the capability is inert and
# no pilot state is created. Independent of the Project Control gates above;
# enabling it never alters project creation or Project Control behavior.
VISUAL_DEV_PILOT_ENABLED=false

# ─── Private archive publisher ───────────────────────────────
# Producer/admin-only Slack workflow. All destinations remain draft/unlisted.
KIT_ARCHIVE_DESTINATIONS=dropbox,vimeo,wordpress,buffer,behance
KIT_ARCHIVE_ROOT=/production/_ProjectArchive/01_Website/01_Projects
# Vercel calls the private Railway FFmpeg endpoint. Use the same random 24+
# character secret in both deployments; never commit the value.
KIT_ARCHIVE_MEDIA_WORKER_URL=
KIT_ARCHIVE_WORKER_SECRET=
VIMEO_ACCESS_TOKEN=
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_TEMPLATE_POST_ID=6343
BUFFER_ACCESS_TOKEN=
BUFFER_LINKEDIN_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_API_URL=https://api.buffer.com/
