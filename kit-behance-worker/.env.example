# Narrow worker broker. This machine must never hold a Supabase service-role key.
KIT_STUDIO_WORKER_API_URL=https://kit-amber.vercel.app/api/internal/studio-worker
# Store the secret in macOS Keychain under service
# com.rangerandfox.kit-studio-worker. An env override is supported for CI only.

# Dedicated local browser identity. Sign in once with `npm run login`.
BEHANCE_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
BEHANCE_PROFILE_DIR=./.behance-profile
BEHANCE_HEADLESS=false
BEHANCE_START_URL=https://www.behance.net/
BEHANCE_CREATIVE_FIELD=Motion Graphics

# Local directory corresponding to Dropbox's cloud root `/`.
DROPBOX_SYNC_PATH=/Users/you/Library/CloudStorage/Dropbox-Ranger&Fox/Ranger & Fox

WORKER_ID=behance-studio-mac
WORKER_DISPLAY_NAME=Studio Behance Worker
POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=10000
JOB_TIMEOUT_MS=1200000
