{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@agents/*": ["../src/lib/inngest/agents/*"],
      "@lib/*": ["../src/lib/*"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src/**/*", "../src/lib/inngest/**/*", "../src/lib/harvest/**/*", "../src/lib/provisioner/**/*", "../src/lib/mcp/slack.ts", "../src/types/**/*.d.ts"]
}
